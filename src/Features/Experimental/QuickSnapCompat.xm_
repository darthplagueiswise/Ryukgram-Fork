#import <substrate.h>

#define IGT_LOG(fmt, ...) NSLog((@"[RyukGram][QSForce] " fmt), ##__VA_ARGS__)

#pragma mark - Trampolines (all log on entry)

#define BOOL_ARG1_YES(fn) \
    static BOOL (*orig_##fn)(id, SEL, id) = NULL; \
    static BOOL new_##fn(id self, SEL _cmd, id a) { \
        IGT_LOG(@"+%@ arg=%@ -> YES (was: would-call-orig)", NSStringFromSelector(_cmd), a); \
        return YES; \
    }

#define BOOL_ARG2_YES(fn) \
    static BOOL (*orig_##fn)(id, SEL, id, id) = NULL; \
    static BOOL new_##fn(id self, SEL _cmd, id a, id b) { \
        IGT_LOG(@"+%@ a=%@ b=%@ -> YES", NSStringFromSelector(_cmd), a, b); \
        return YES; \
    }

#define BOOL_ARG0_YES(fn) \
    static BOOL (*orig_##fn)(id, SEL) = NULL; \
    static BOOL new_##fn(id self, SEL _cmd) { \
        IGT_LOG(@"-[%@ %@] -> YES", NSStringFromClass(object_getClass(self)), NSStringFromSelector(_cmd)); \
        return YES; \
    }

#define BOOL_ARG0_NO(fn) \
    static BOOL (*orig_##fn)(id, SEL) = NULL; \
    static BOOL new_##fn(id self, SEL _cmd) { \
        IGT_LOG(@"-[%@ %@] -> NO", NSStringFromClass(object_getClass(self)), NSStringFromSelector(_cmd)); \
        return NO; \
    }

